<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %>
<!doctype html><html><head><title>LEDGERLINE / ${view}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body>
<aside><div class="brand">LEDGER<span>LINE</span></div><p class="eyebrow">CONTROL DESK</p><nav><a href="dashboard">Overview</a><a href="products">Products</a><a href="inventory">Inventory</a><a href="purchases">Purchasing</a><a href="masters">Suppliers & locations</a><a href="ledger">Stock ledger</a><a href="audit">Activity history</a><a href="export.csv">Export CSV</a></nav><div class="user"><strong>${sessionScope.user.name}</strong><small>${sessionScope.user.role}</small><a href="${pageContext.request.contextPath}/logout">Sign out</a></div></aside>
<main class="shell"><header><div><p class="eyebrow">${view}</p><h1>${view == 'dashboard' ? 'The inventory, at a glance.' : view}</h1></div><div class="status"><i></i>Database connected</div></header>
<% if(session.getAttribute("error")!=null){%><div class="alert"><%=session.getAttribute("error")%></div><%session.removeAttribute("error");}%>
<% if("dashboard".equals(request.getAttribute("view"))){%><section class="metrics"><article><small>ACTIVE PRODUCTS</small><strong>${products}</strong><span>catalogued items</span></article><article><small>UNITS ON HAND</small><strong>${stock}</strong><span>across all locations</span></article><article><small>INVENTORY VALUE</small><strong>€ ${value}</strong><span>at current cost</span></article><article class="warning"><small>LOW STOCK</small><strong>${low}</strong><span>needs attention</span></article></section><section class="split"><div class="panel"><h2>Every unit has a story.</h2><p class="muted">Record receipts, issues, transfers and corrections against a real location. The ledger preserves who changed what and why.</p><div class="quick"><a href="products">Manage products →</a><a href="purchases">Open purchasing →</a><a href="ledger">Review ledger →</a></div></div><div class="panel accent"><p class="eyebrow">OPERATING PRINCIPLE</p><h2>Purchase orders do not move stock.</h2><p>Only a validated receipt increases inventory. Issues and sales decrease it, while transfers remain balanced across warehouses.</p></div></section>
<% } else if("products".equals(request.getAttribute("view"))){%><div class="toolbar"><form><input name="q" placeholder="Search SKU or name"><button>Search</button></form></div><div class="panel"><h2>Add product</h2><form class="grid-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="save"><input type="hidden" name="entity" value="product"><input type="hidden" name="returnTo" value="products"><label>SKU<input name="sku" required></label><label>Name<input name="name" required></label><label>Category<select name="categoryId" required><%for(Map x:(List<Map>)request.getAttribute("categories")){%><option value="<%=x.get("id")%>"><%=x.get("name")%></option><%}%></select></label><label>Supplier<select name="supplierId" required><%for(Map x:(List<Map>)request.getAttribute("suppliers")){%><option value="<%=x.get("id")%>"><%=x.get("name")%></option><%}%></select></label><label>Reorder level<input name="reorderLevel" type="number" step=".001" min="0" required></label><label>Cost<input name="cost" type="number" step=".01" min="0" required></label><label>Price<input name="price" type="number" step=".01" min="0" required></label><button class="primary">Create product</button></form></div><div class="panel table-wrap"><table><thead><tr><th>SKU</th><th>PRODUCT</th><th>CATEGORY</th><th>ON HAND</th><th>REORDER</th><th>PRICE</th><th></th></tr></thead><tbody><%for(Map x:(List<Map>)request.getAttribute("rows")){%><tr><td class="mono"><%=x.get("sku")%></td><td><strong><%=x.get("name")%></strong></td><td><%=x.get("category")%></td><td><%=x.get("quantity")%></td><td><%=x.get("reorder_level")%></td><td>€ <%=x.get("price")%></td><td><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="entity" value="product"><input type="hidden" name="id" value="<%=x.get("id")%>"><input type="hidden" name="returnTo" value="products"><button>Archive</button></form></td></tr><%}%></tbody></table></div>
<% } else if("inventory".equals(request.getAttribute("view"))){%><div class="panel"><h2>Record stock movement</h2><form class="grid-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="stock"><input type="hidden" name="returnTo" value="inventory"><label>Product ID<input name="productId" type="number" required></label><label>Warehouse ID<input name="warehouseId" type="number" required></label><label>Location ID<input name="locationId" type="number" required></label><label>Type<select name="type"><option value="RECEIPT">Receipt</option><option value="ISSUE">Issue</option><option value="RETURN">Return</option><option value="ADJUSTMENT">Adjustment</option><option value="DAMAGE">Damaged goods</option></select></label><label>Quantity<input name="quantity" type="number" step=".001" min=".001" required></label><label>Reference<input name="reference" required></label><label class="wide">Reason<input name="reason" required></label><button class="primary">Post movement</button></form></div><div class="panel"><h2>Sale / issue</h2><form class="grid-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="sale"><input type="hidden" name="returnTo" value="inventory"><label>Order number<input name="orderNumber" required></label><label>Customer<input name="customer" required></label><label>Product ID<input name="productId" type="number" required></label><label>Warehouse ID<input name="warehouseId" type="number" required></label><label>Location ID<input name="locationId" type="number" required></label><label>Quantity<input name="quantity" type="number" step=".001" min=".001" required></label><label>Unit price<input name="price" type="number" step=".01" min="0" required></label><button class="primary">Complete sale</button></form></div>
<% } else if("purchases".equals(request.getAttribute("view"))){%><div class="panel"><h2>Create purchase order</h2><form class="grid-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="purchase"><input type="hidden" name="returnTo" value="purchases"><label>Order number<input name="orderNumber" required></label><label>Supplier<select name="supplierId"><%for(Map x:(List<Map>)request.getAttribute("suppliers")){%><option value="<%=x.get("id")%>"><%=x.get("name")%></option><%}%></select></label><label>Warehouse<select name="warehouseId"><%for(Map x:(List<Map>)request.getAttribute("warehouses")){%><option value="<%=x.get("id")%>"><%=x.get("name")%></option><%}%></select></label><label>Product<select name="productId"><%for(Map x:(List<Map>)request.getAttribute("products")){%><option value="<%=x.get("id")%>"><%=x.get("sku")%> / <%=x.get("name")%></option><%}%></select></label><label>Quantity<input name="quantity" type="number" step=".001" min=".001" required></label><label>Unit cost<input name="cost" type="number" step=".01" min="0" required></label><button class="primary">Save draft</button></form></div><div class="panel table-wrap"><table><thead><tr><th>ORDER</th><th>SUPPLIER</th><th>WAREHOUSE</th><th>STATUS</th><th>DATE</th><th>ACTIONS</th></tr></thead><tbody><%for(Map x:(List<Map>)request.getAttribute("purchases")){%><tr><td class="mono"><%=x.get("order_number")%></td><td><%=x.get("supplier")%></td><td><%=x.get("warehouse")%></td><td><span class="tag"><%=x.get("status")%></span></td><td><%=x.get("ordered_at")%></td><td><%if("DRAFT".equals(x.get("status"))){%><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="approve"><input type="hidden" name="id" value="<%=x.get("id")%>"><input type="hidden" name="returnTo" value="purchases"><button>Approve</button></form><%}else if("APPROVED".equals(x.get("status"))||"PARTIALLY_RECEIVED".equals(x.get("status"))){%><a href="inventory">Receive in Inventory →</a><%}%></td></tr><%}%></tbody></table></div>
<% } else if("masters".equals(request.getAttribute("view"))){%><div class="split"><div class="panel"><h2>Supplier</h2><form class="stack-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="save"><input type="hidden" name="entity" value="supplier"><input type="hidden" name="returnTo" value="masters"><input name="name" placeholder="Supplier name" required><input name="email" type="email" placeholder="Email"><input name="phone" placeholder="Phone"><button class="primary">Add supplier</button></form><%for(Map x:(List<Map>)request.getAttribute("suppliers")){%><p><strong><%=x.get("name")%></strong><br><small><%=x.get("email")%> · <%=x.get("phone")%></small></p><%}%></div><div class="panel"><h2>Category</h2><form class="stack-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="save"><input type="hidden" name="entity" value="category"><input type="hidden" name="returnTo" value="masters"><input name="name" placeholder="Category name" required><input name="description" placeholder="Description"><button class="primary">Add category</button></form><%for(Map x:(List<Map>)request.getAttribute("categories")){%><p><strong><%=x.get("name")%></strong><br><small><%=x.get("description")%></small></p><%}%></div></div><div class="panel"><h2>Warehouse and location creation</h2><form class="grid-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="save"><input type="hidden" name="entity" value="warehouse"><input type="hidden" name="returnTo" value="masters"><label>Warehouse<input name="name" required></label><label>Address<input name="address"></label><button class="primary">Add warehouse</button></form><form class="grid-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="save"><input type="hidden" name="entity" value="location"><input type="hidden" name="returnTo" value="masters"><label>Warehouse ID<input name="warehouseId" type="number" required></label><label>Location code<input name="code" required></label><button class="primary">Add location</button></form><%for(Map x:(List<Map>)request.getAttribute("locations")){%><span class="tag"><%=x.get("warehouse")%> / <%=x.get("code")%></span> <%}%></div>
<% } else if("audit".equals(request.getAttribute("view"))){%><div class="panel table-wrap"><table><thead><tr><th>WHEN</th><th>USER</th><th>ACTION</th><th>ENTITY</th><th>DETAILS</th></tr></thead><tbody><%for(Map x:(List<Map>)request.getAttribute("rows")){%><tr><td><%=x.get("created_at")%></td><td><%=x.get("email")%></td><td><%=x.get("action")%></td><td><%=x.get("entity")%> #<%=x.get("entity_id")%></td><td><%=x.get("details")%></td></tr><%}%></tbody></table></div>
<% } else {%><div class="panel table-wrap"><table><thead><tr><th>REFERENCE</th><th>PRODUCT</th><th>WAREHOUSE</th><th>QUANTITY</th><th>TYPE</th><th>WHEN</th></tr></thead><tbody><%for(Map x:(List<Map>)request.getAttribute("rows")){%><tr><td class="mono"><%=x.get("reference")%></td><td><strong><%=x.get("product")%></strong><br><small><%=x.get("sku")%></small></td><td><%=x.get("warehouse")%></td><td><%=x.get("quantity")%></td><td><span class="tag"><%=x.get("type")%></span></td><td><%=x.get("created_at")%></td></tr><%}%></tbody></table></div><%}%>
</main></body></html>
